            },
            "description": "Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "mobius_session": []
          }
        ],
        "tags": [
          "workstreams"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Activity": {
        "type": "object",
        "title": "Activity",
        "properties": {
          "actor": {
            "type": "string",
            "description": "Actor is the GitHub login that did the activity"
          },
          "id": {
            "type": "integer",
            "description": "ID increases with each new activity"
          },
          "issue": {
            "type": "integer",
            "description": "Issue is the number of the issue of the activity"
          },
          "link": {
            "type": "string",
            "description": "Link is the GitHub URL of the activity"
          },
          "repository": {
            "type": "string",
            "description": "Repository is the repository of the Workstream issue, as \"owner/name\""
          },
          "text": {
            "type": "string",
            "description": "Text tells what happened"
          },
          "time": {
            "type": "string",
            "description": "Time is the time of the activity",
            "format": "date-time"
          },
          "workstream": {
            "type": "integer",
            "description": "Workstream is the number of the Workstream issue"
          }
        },
        "required": [
          "id",
          "time",
          "repository",
          "workstream",
          "issue",
          "actor",
          "text",
          "link"
        ],
        "description": "Activity is an entry of the activity feed of a Workstream."
      },
      "Checkup": {
        "type": "object",
        "title": "Checkup",
        "properties": {
          "labelFix": {
            "type": "string",
            "description": "LabelFix is create when all Mobius labels are missing, fix when another label is missing or has a different color, and none when the fix has nothing to change",
            "enum": [
              "create",
              "fix",
              "none"
            ]
          },
          "permissions": {
            "type": "array",
            "title": "[]PermissionCheck",
            "description": "Permissions are the permissions of the App of the first repository. It is empty when the organization has no repository or the check failed",
            "items": {
              "$ref": "#/components/schemas/PermissionCheck"
            }
          },
          "permissionsError": {
            "type": "string",
            "description": "PermissionsError is the error of the permission check, or empty"
          },
          "repositories": {
            "type": "array",
            "title": "[]RepositoryCheckup",
            "description": "Repositories are the repositories of the organization, in name order",
            "items": {
              "$ref": "#/components/schemas/RepositoryCheckup"
            }
          }
        },
        "required": [
          "repositories",
          "permissions",
          "permissionsError",
          "labelFix"
        ],
        "description": "Checkup is the status of the App permissions and of the Mobius labels in an organization."
      },
      "CreateManifestFormBody": {
        "type": "object",
        "title": "CreateManifestFormBody",
        "properties": {
          "account": {
            "type": "string",
            "description": "Account is the GitHub user or organization that owns the new App"
          },
          "name": {
            "type": "string",
            "description": "Name is the name of the new App"
          },
          "origin": {
            "type": "string",
            "description": "Origin is the origin of the Mobius UI, for example https://mobius.example.ts.net"
          }
        },
        "required": [
          "account",
          "origin"
        ]
      },
      "DeviceLogin": {
        "type": "object",
        "title": "DeviceLogin",
        "properties": {
          "createdAt": {
            "type": "string",
            "description": "CreatedAt is the time of the login",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "description": "ID is the id of the device login"
          },
          "userAgent": {
            "type": "string",
            "description": "UserAgent names the browser of the device"
          }
        },
        "required": [
          "id",
          "userAgent",
          "createdAt"
        ],
        "description": "DeviceLogin is the login of a device with the access password."
      },
      "Devices": {
        "type": "object",
        "title": "Devices",
        "properties": {
          "logins": {
            "type": "array",
            "title": "[]DeviceLogin",
            "description": "Logins are the device logins, the newest first",
            "items": {
              "$ref": "#/components/schemas/DeviceLogin"
            }
          },
          "thisDevice": {
            "type": "integer",
            "description": "ThisDevice is the id of the device login of the request"
          }
        },
        "required": [
          "thisDevice",
          "logins"
        ],
        "description": "Devices are the device logins."
      },
      "Envelope_Array_GitHubApp": {
        "type": "object",
        "title": "Envelope_Array_GitHubApp",
        "properties": {
          "data": {
            "type": "array",
            "title": "[]GitHubApp",
            "description": "Data is the payload of the response",
            "items": {
              "$ref": "#/components/schemas/GitHubApp"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "Envelope_Array_Workstream": {
        "type": "object",
        "title": "Envelope_Array_Workstream",
        "properties": {
          "data": {
            "type": "array",
            "title": "[]Workstream",
            "description": "Data is the payload of the response",
            "items": {
              "$ref": "#/components/schemas/Workstream"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "Envelope_Array_string": {
        "type": "object",
        "title": "Envelope_Array_string",
        "properties": {
          "data": {
            "type": "array",
            "title": "[]string",
            "description": "Data is the payload of the response",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "Envelope_Checkup": {
        "type": "object",
        "title": "Envelope_Checkup",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Checkup",
            "description": "Data is the payload of the response"
          }
        },
        "required": [
          "data"
        ]
      },
      "Envelope_Devices": {
        "type": "object",
        "title": "Envelope_Devices",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Devices",
            "description": "Data is the payload of the response"
          }
        },
        "required": [
          "data"
        ]
      },
      "Envelope_Health": {
        "type": "object",
        "title": "Envelope_Health",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Health",
            "description": "Data is the payload of the response"
          }
        },
        "required": [
          "data"
        ]
      },
      "Envelope_ManifestForm": {
        "type": "object",
        "title": "Envelope_ManifestForm",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ManifestForm",
            "description": "Data is the payload of the response"
          }
        },
        "required": [
          "data"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "title": "ErrorResponse",
        "properties": {
          "details": {
            "type": "object",
            "description": "Additional error details",
            "additionalProperties": {}
          },
          "error": {
            "type": "string",
            "description": "Error message"
          }
        },
        "required": [
          "error"
        ],
        "description": "Generic error response structure"
      },
      "FixLabelsBody": {
        "type": "object",
        "title": "FixLabelsBody",
        "properties": {
          "organization": {
            "type": "string",
            "description": "Organization is the owner of the repositories"
          }
        },
        "required": [
          "organization"
        ]
      },
      "GitHubApp": {
        "type": "object",
        "title": "GitHubApp",
        "properties": {
          "installUrl": {
            "type": "string",
            "description": "InstallURL is the page of GitHub that installs the App on repositories"
          },
          "repositories": {
            "type": "array",
            "title": "[]string",
            "description": "Repositories are the repositories of the installations of the App, as \"owner/name\"",
            "items": {
              "type": "string"
            }
          },
          "slug": {
            "type": "string",
            "description": "Slug is the name of the App in its GitHub URLs"
          }
        },
        "required": [
          "slug",
          "installUrl",
          "repositories"
        ],
        "description": "GitHubApp is a Mobius App on GitHub."
      },
      "Health": {
        "type": "object",
        "title": "Health",
        "properties": {
          "status": {
            "type": "string",
            "description": "Status is \"ok\" when the server can serve requests"
          },
          "time": {
            "type": "string",
            "description": "Time is the current time of the server",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "time"
        ],
        "description": "Health is the state of the server."
      },
      "LabelCheck": {
        "type": "object",
        "title": "LabelCheck",
        "properties": {
          "color": {
            "type": "string",
            "description": "Color is the fixed color of the Mobius label, as six hex digits with no \"#\""
          },
          "found": {
            "type": "string",
            "description": "Found is the color on GitHub for wrong-color, and the name on GitHub for wrong-case"
          },
          "name": {
            "type": "string",
            "description": "Name is the name of the Mobius label"
          },
          "status": {
            "type": "string",
            "description": "Status is wrong-color for a label with a different color, and wrong-case for a label with its name in a different case. Mobius does not rename labels, so the Owner fixes a wrong case",
            "enum": [
              "present",
              "wrong-color",
              "wrong-case",
              "missing"
            ]
          }
        },
        "required": [
          "name",
          "color",
          "status",
          "found"
        ],
        "description": "LabelCheck is the status of a Mobius label in a repository."
      },
      "LiveEvents": {
        "title": "LiveEvents",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "contentMediaType": "application/json",
                "contentSchema": {
                  "$ref": "#/components/schemas/Activity"
                }
              },
              "event": {
                "type": "string",
                "const": "activity"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "event",
              "data"
            ]
          }
        ],
        "description": "LiveEvents are the events of the live event stream."
      },
      "LoginBody": {
        "type": "object",
        "title": "LoginBody",
        "properties": {
          "password": {
            "type": "string",
            "description": "Password is the access password"
          }
        },
        "required": [
          "password"
        ]
      },
      "ManifestForm": {
        "type": "object",
        "title": "ManifestForm",
        "properties": {
          "manifest": {
            "type": "string",
            "description": "Manifest is the value of the form field \"manifest\""
          },
          "url": {
            "type": "string",
            "description": "URL is the action of the form"
          }
        },
        "required": [
          "url",
          "manifest"
        ],
        "description": "ManifestForm is the form that the browser posts to GitHub to create a Mobius App."
      },
      "PermissionCheck": {
        "type": "object",
        "title": "PermissionCheck",
        "properties": {
          "level": {
            "type": "string",
            "description": "Level is the required level"
          },
          "name": {
            "type": "string",
            "description": "Name is the name of the permission"
          },
          "status": {
            "type": "string",
            "description": "Status is not-accepted when the App has the permission and the installation does not",
            "enum": [
              "present",
              "not-accepted",
              "missing"
            ]
          },
          "url": {
            "type": "string",
            "description": "URL is the page of GitHub where the Owner accepts or adds the permission. It is empty for present"
          }
        },
        "required": [
          "name",
          "level",
          "status",
          "url"
        ],
        "description": "PermissionCheck is the status of a permission that the Mobius App needs."
      },
      "RepositoryCheckup": {
        "type": "object",
        "title": "RepositoryCheckup",
        "properties": {
          "labels": {
            "type": "array",
            "title": "[]LabelCheck",
            "description": "Labels are the Mobius labels",
            "items": {
              "$ref": "#/components/schemas/LabelCheck"
            }
          },
          "repository": {
            "type": "string",
            "description": "Repository is the repository as \"owner/name\""
          }
        },
        "required": [
          "repository",
          "labels"
        ],
        "description": "RepositoryCheckup is the status of each Mobius label in a repository."
      },
      "ValidationErrorResponse": {
        "type": "object",
        "title": "ValidationErrorResponse",
        "properties": {
          "details": {
            "type": "object",
            "description": "Field-level validation errors (maps field names to arrays of error messages)",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "error": {
            "type": "string",
            "description": "Error message"
          }
        },
        "required": [
          "error"
        ],
        "description": "Validation error response with field-level details"
      },
      "Workstream": {
        "type": "object",
        "title": "Workstream",
        "properties": {
          "lastActivity": {
            "type": "string",
            "description": "LastActivity is the time of the latest row of the Workstream",
            "format": "date-time"
          },
          "number": {
            "type": "integer",
            "description": "Number is the number of the Workstream issue"
          },
          "openTasks": {
            "type": "integer",
            "description": "OpenTasks is the number of tasks that are not ended or stopped"
          },
          "repository": {
            "type": "string",
            "description": "Repository is the repository of the Workstream issue, as \"owner/name\""
          },
          "tasks": {
            "type": "integer",
            "description": "Tasks is the number of tasks of the Workstream"
          }
        },
        "required": [
          "repository",
          "number",
          "tasks",
          "openTasks",
          "lastActivity"
        ],
        "description": "Workstream is a Workstream that has rows in the database."
      }
    },
    "securitySchemes": {
      "mobius_session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mobius_session"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request - Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Unprocessable Entity - Request body could not be parsed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
