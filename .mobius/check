#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

unformatted=$(gofmt -l $(go list -f '{{.Dir}}' ./...))
if [ -n "$unformatted" ]; then
  echo "gofmt: these files need formatting:" >&2
  echo "$unformatted" >&2
  exit 1
fi

go vet ./...
golangci-lint run
go tool lintgork ./...
go test ./...

(
  cd web
  pnpm install --frozen-lockfile
  pnpm lint
  pnpm format:check
  pnpm build
)

go build ./...

make generate
git diff --exit-code -- api/ web/src/api/ internal/store/
untracked=$(git ls-files --others --exclude-standard -- api/ web/src/api/ internal/store/)
if [ -n "$untracked" ]; then
  echo "make generate: these new files are not committed:" >&2
  echo "$untracked" >&2
  exit 1
fi
