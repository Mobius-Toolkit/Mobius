#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

golangci-lint run
go tool lintgork ./...
if [ -n "${CI:-}" ]; then
  go test -timeout 30m ./...
fi

(
  cd web
  pnpm install --frozen-lockfile
  pnpm lint
  pnpm format:check
  pnpm build
)

make generate
git diff --exit-code -- api/ web/src/api/ internal/store/
untracked=$(git ls-files --others --exclude-standard -- api/ web/src/api/ internal/store/)
if [ -n "$untracked" ]; then
  echo "make generate: these new files are not committed:" >&2
  echo "$untracked" >&2
  exit 1
fi
