    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "happy-dom": "^21.0.4",
    "orval": "8.47.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2",
